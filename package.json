{
  "name": "logiqual",
  "version": "2.0.0",
  "description": "A lightweight library for comparing boolean functions and generating truth tables.",
  "keywords": [
    "boolean",
    "logic",
    "comparison",
    "truth table",
    "functions",
    "logical",
    "algebra"
  ],
  "homepage": "https://github.com/kamdz/logiqual#readme",
  "bugs": {
    "url": "https://github.com/kamdz/logiqual/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdz/logiqual.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kamil Dzwonkowski",
    "email": "npm@kamdz.dev",
    "url": "https://github.com/kamdz"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "logiqual": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "cli": "node src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bin-perm-gen": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
